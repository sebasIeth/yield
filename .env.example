# API key de Yield.xyz — obtener en https://yield.xyz/contact
YIELD_API_KEY=

# Secreto del servidor para firmar los tokens de sesión del admin (HMAC).
# Poné un valor largo y aleatorio. NO es la contraseña de login.
ADMIN_KEY=

# MongoDB — almacena la curación de bolsas y los usuarios admin
# (colecciones `curation` y `admins`).
MONGODB_URI=
MONGODB_DB=yield_xyz

# Los admins (email + contraseña + secreto 2FA) se crean en MongoDB con:
#   node scripts/seed-admins.mjs email1@x.com email2@x.com
