# API key de Yield.xyz — obtener en https://yield.xyz/contact
YIELD_API_KEY=

# Clave para el panel /admin (1er factor)
ADMIN_KEY=

# Secreto TOTP en Base32 para el 2FA del /admin (2do factor).
# Generar uno y agregarlo a Google Authenticator/Authy. Si se deja vacío, el
# login pide solo la clave (2FA desactivado).
ADMIN_TOTP_SECRET=

# MongoDB — almacena la curación de bolsas (colección `curation`)
MONGODB_URI=
MONGODB_DB=yield_xyz
